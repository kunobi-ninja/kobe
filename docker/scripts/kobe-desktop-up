#!/usr/bin/env bash
# Own the desktop lifetime in one foreground process (runner exec or tmux).
# Runner executions are capped at one hour; tmux follows the lease lifetime.
# Independent
# application executions inherit DISPLAY, XAUTHORITY and the session bus address
# from the image. Only Kobe's declared-port tunnel should expose the browser UI.
set -euo pipefail

umask 077
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"
exec 9>"$XDG_RUNTIME_DIR/desktop.lock"
flock -n 9 || {
  echo "A desktop is already running." >&2
  exit 1
}

pids=()
# Invoked by the EXIT trap, including signal and startup failures.
# shellcheck disable=SC2329
cleanup() {
  trap - EXIT TERM INT
  if ((${#pids[@]})); then
    kill "${pids[@]}" 2>/dev/null || true
    # Bound cleanup even if a component stops responding to TERM.
    for _ in {1..20}; do
      [[ -z $(jobs -pr) ]] && break
      sleep 0.1
    done
    kill -KILL "${pids[@]}" 2>/dev/null || true
    wait "${pids[@]}" 2>/dev/null || true
  fi
  rm -f "$XAUTHORITY" "$XDG_RUNTIME_DIR/bus"
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT

start() {
  "$@" 9>&- &
  pids+=("$!")
}

# Convenience windows must not control the desktop lifetime: users should be
# able to close the initial terminal without taking down Xvnc or x11vnc.
start_optional() {
  "$@" 9>&- &
}

ready() {
  local deadline=$((SECONDS + 30))
  until "$@" >/dev/null 2>&1; do
    for pid in "${pids[@]}"; do
      kill -0 "$pid" 2>/dev/null || {
        echo "Desktop component exited during startup." >&2
        exit 1
      }
    done
    ((SECONDS < deadline)) || {
      echo "Desktop readiness timed out: $1" >&2
      exit 1
    }
    sleep 0.1
  done
}

# Unix-domain X11 only, with a fresh cookie readable only by this workload UID.
rm -f "$XAUTHORITY" "$XDG_RUNTIME_DIR/bus"
mkdir -p "$HOME/.vnc"
touch "$XAUTHORITY"
xauth -f "$XAUTHORITY" add "$DISPLAY" . "$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
# KasmVNC is the X server and the browser viewer (HTTP on 6080). It does not
# speak standard RFB, so x11vnc still attaches to this display for
# `kobe vnc paste` / screenshot / click.
start Xvnc "$DISPLAY" -geometry 1440x900 -depth 24 \
  -auth "$XAUTHORITY" \
  -interface 127.0.0.1 \
  -websocketPort 6080 \
  -httpd /usr/share/kasmvnc/www \
  -disableBasicAuth \
  -AlwaysShared \
  -BlacklistThreshold 0 \
  -FrameRate 60 \
  -SecurityTypes None
ready xdpyinfo -display "$DISPLAY"
ready curl --fail --silent http://127.0.0.1:6080/

start dbus-daemon --session --nofork --address="$DBUS_SESSION_BUS_ADDRESS"
ready dbus-send --session --dest=org.freedesktop.DBus --type=method_call --print-reply / org.freedesktop.DBus.ListNames
start openbox --sm-disable
# Openbox clears the root window when it takes over the screen, so a colour set
# before it runs is lost and the desktop comes up black. Paint once it has
# announced itself as the window manager.
ready bash -c 'xprop -root _NET_SUPPORTING_WM_CHECK | grep -q "window id"'
xsetroot -solid '#17324d'
xset -dpms || true
xset s off || true
# A visible terminal makes an otherwise empty desktop immediately usable. The
# Openbox right-click menu also exposes Terminal, Browser, and desktop status.
start_optional xterm -title 'Kobe workspace' -geometry 100x28+32+32 -fa Monospace -fs 11 -e bash -lc 'printf "Kobe GUI workspace ready.\nRight-click the desktop for Terminal, Browser, and status.\n\n"; exec bash'
# Standard RFB for the CLI. No password: kobe vnc screenshot/click speak
# security None, and the authenticated Kobe forward is the gate.
# Do not pass -clipboard: Debian's x11vnc 0.9.16 treats it as unknown and
# exits, which takes the whole desktop down. RFB ClientCutText plus
# autocutsel still put paste on CLIPBOARD and PRIMARY.
start x11vnc -display "$DISPLAY" -auth "$XAUTHORITY" -forever -shared \
  -localhost -listen 127.0.0.1 -rfbport 5900 -nopw \
  -xkb -repeat -noxdamage
ready bash -c 'exec 3<>/dev/tcp/127.0.0.1/5900'
start_optional autocutsel -selection CLIPBOARD
start_optional autocutsel -selection PRIMARY
printf '%s\n' 'Desktop ready on DISPLAY=:99. kobe vnc open <lease>'

# Any component exit (even zero) ends the desktop and fails the execution.
status=0
wait -n "${pids[@]}" || status=$?
echo "Desktop component exited (status $status); stopping desktop." >&2
exit 1
