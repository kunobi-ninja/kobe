#!/bin/sh
# Serve one SSH session over stdin/stdout for `kobe ssh-proxy`.
#
# The proxy runs this through `kobe attach --no-tty`, so stdin and stdout are
# the SSH transport and must carry nothing else. Diagnostics go to stderr.
#
# The host key is generated on first use under $HOME, so every sandbox gets
# its own and the image ships none. Two sessions starting at once may both
# reach the generation step: each writes a private candidate and links it
# into place, and the first link wins. The loser's candidate is discarded.
#
# `--check` validates the configuration and key material without serving
# a session; the image build uses it as a proof that sshd can run as the
# workload user.
#
# `--session NAME` (from `ssh kobe-<name>.NAME`) makes interactive logins land
# in the `kobe-runner` session NAME, whose shell outlives the connection. sshd
# runs this script again as its ForceCommand with `--login NAME`; anything the
# client asked for other than a login shell (a command, scp, sftp, an editor's
# remote server) runs exactly as it would without a session.
set -eu

if [ "${1:-}" = "--login" ]; then
    # sshd replaced the client's command with this one; SSH_ORIGINAL_COMMAND
    # holds what was asked for, including a subsystem's command for sftp.
    if [ -n "${SSH_ORIGINAL_COMMAND:-}" ]; then
        exec "${SHELL:-/bin/sh}" -c "${SSH_ORIGINAL_COMMAND}"
    fi
    exec /kobe-runner session attach --name "${2:?session name}"
fi

session=
if [ "${1:-}" = "--session" ]; then
    session="${2:-}"
    case "${session}" in
        '' | *[!a-z0-9-]*)
            echo "kobe-sshd: session name must be lowercase letters, digits and '-'" >&2
            exit 2
            ;;
    esac
    if [ "${#session}" -gt 64 ]; then
        echo "kobe-sshd: session name is longer than 64 characters" >&2
        exit 2
    fi
fi

config=/etc/kobe/sshd_config
dir="${HOME}/.ssh"
key="${dir}/kobe_host_ed25519_key"

umask 077
mkdir -p "${dir}"
[ -e "${dir}/authorized_keys" ] || : > "${dir}/authorized_keys"

if [ ! -f "${key}" ]; then
    candidate="${key}.$$"
    ssh-keygen -q -t ed25519 -N '' -C 'kobe-sandbox' -f "${candidate}" >/dev/null 2>&1
    ln "${candidate}" "${key}" 2>/dev/null || true
    ln "${candidate}.pub" "${key}.pub" 2>/dev/null || true
    rm -f "${candidate}" "${candidate}.pub"
fi

if [ "${1:-}" = "--check" ]; then
    exec /usr/sbin/sshd -t -f "${config}" -o "HostKey=${key}"
fi

if [ -n "${session}" ]; then
    exec /usr/sbin/sshd -i -e -f "${config}" -o "HostKey=${key}" \
        -o "ForceCommand=/usr/local/bin/kobe-sshd --login ${session}"
fi

exec /usr/sbin/sshd -i -e -f "${config}" -o "HostKey=${key}"
